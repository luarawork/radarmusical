# Copie este arquivo para ".env" e preencha. Nunca publique o .env.

# --- Obrigatório ---------------------------------------------------------------
# Seu nome de usuário no Last.fm (o perfil precisa ser público) e a sua API key.
LASTFM_USER=
LASTFM_API_KEY=

# --- Lançamentos ---------------------------------------------------------------
# De onde buscar os lançamentos: "deezer" (padrão, sem chave e sem cota diária)
# ou "spotify" (exige app no Spotify com conta Premium e tem cota diária).
FONTE_LANCAMENTOS=deezer
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Página --------------------------------------------------------------------
# Em qual app o botão "Ouvir" abre por padrão (dá pra trocar na própria página):
# spotify, apple, ytmusic, deezer, tidal ou amazon
APP_MUSICA=spotify

# --- Opcional: histórico de outros apps ----------------------------------------
# Pasta(s) extra com os dados que você baixou do Spotify, YouTube Music etc. (docs/historico.md)
# A pasta "historico" do projeto já é lida sempre. Separe várias com ";".
HISTORICO_PASTA=

# --- Opcional: curti / não curti em vários aparelhos ---------------------------
# Pasta(s) onde você salva os arquivos de gostos de todos os aparelhos,
# ex.: uma pasta do Google Drive ou OneDrive. A pasta "gostos" e Downloads
# já são lidas sempre. Separe várias com ";".
GOSTOS_PASTA=

# --- Opcional: publicar no GitHub Pages (pra instalar no celular) --------------
# Repositório PÚBLICO só pra página, no formato usuario/nome (ex.: maria/meu-radar)
# e um token "fine-grained" com acesso só a esse repositório (Contents e Pages: Read and write).
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main
